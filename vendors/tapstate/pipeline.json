{
  "id": "bench_orders",
  "sources": ["<oracle-source-id>"],
  "settings": {"read_mode": "snapshot_and_cdc"},
  "transforms": [{
    "id": "order_doc", "type": "nest",
    "from": {"o": "BENCH_ORDERS", "l": "BENCH_LINES", "c": "BENCH_CUSTOMERS"},
    "root": {"from": "o", "key": ["ORDER_ID"], "embed": [
      {"from": "l", "on": {"ORDER_ID": "ORDER_ID"}, "as": "array", "path": "lines", "arrayKey": ["LINE_NO"]},
      {"from": "c", "on": {"CUSTOMER_ID": "CUSTOMER_ID"}, "as": "object", "path": "customer"}
    ]}
  }],
  "serve": {"from": "order_doc", "sync": [{
    "id": "bench_orders_to_atlas", "source": "<atlas-destination-id>",
    "write_mode": "upsert", "on_full_load": "clear",
    "database": "cr_tapstate", "collection": "orders"
  }]}
}
