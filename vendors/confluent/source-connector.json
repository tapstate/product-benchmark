{
  "name": "bench-oracle-cdc",
  "config": {
    "connector.class": "OracleCdcSource",
    "name": "bench-oracle-cdc",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "<redacted>",
    "kafka.api.secret": "<redacted>",
    "oracle.server": "<oracle-host>",
    "oracle.port": "1521",
    "oracle.sid": "orcl",
    "oracle.username": "<dba-role user>",
    "oracle.password": "<redacted>",
    "table.inclusion.regex": ".*[.]C##TAPDATA[.]BENCH_(CUSTOMERS|ORDERS|LINES)",
    "start.from": "snapshot",
    "redo.log.topic.name": "bench-redo-log",
    "table.topic.name.template": "bench.${tableName}",
    "key.template": "${primaryKeyStruct}",
    "output.data.key.format": "AVRO",
    "output.data.value.format": "AVRO",
    "emit.tombstone.on.delete": "false",
    "oracle.supplemental.log.level": "full",
    "tasks.max": "1"
  }
}
