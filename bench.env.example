# Copy to bench.env (chmod 600). Never commit bench.env.
ORACLE_HOST=your-rds-endpoint.region.rds.amazonaws.com
ORACLE_PORT=1521
# Either ORACLE_SERVICE (RDS: the DB name, e.g. ORCL) or ORACLE_SID
ORACLE_SERVICE=ORCL
ORACLE_USER=BENCH
ORACLE_PASSWORD=change-me
# Optional: schema that owns the BENCH_* tables (default: ORACLE_USER)
# ORACLE_SCHEMA=BENCH
# Optional: Oracle Instant Client directory for thick mode (needed only for pre-12.1 servers)
# ORACLE_CLIENT_DIR=/opt/oracle/instantclient
ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
